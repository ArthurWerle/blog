---
export const prerender = true
import BaseLayout from "../layouts/BaseLayout.astro"
import Projects from "../components/Projects.astro"

const pageTitle = "Arthur Werle"
---

<BaseLayout pageTitle={pageTitle}>
  <div>
    <p class="text-md md:text-xl pb-4 mt-4">
      Currently crafting software for 
      <a class="unset animated-link underline gap-1 text-lg md:text-2xl inline text-emphasis font-instrument mb-[-8px] font-bold" href="https://www.twoboxes.com/" target="_blank">TwoBoxes</a> 
    </p>
  </div>

  <div>
    <section class="mt-10">
      <Projects numberOfProjectsToShow={4} />
    </section>
  </div>
</BaseLayout>
